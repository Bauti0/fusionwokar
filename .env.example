PORT=3001

# Mercado Pago (Orders API: el pago ocurre en el checkout alojado por MP,
# así que no hace falta clave pública ni SDK en el browser)
MP_ACCESS_TOKEN=
# Secret de la app en MP (Panel → tu app → Webhooks). OBLIGATORIO en producción:
# sin él (o con un valor de ejemplo) el webhook rechaza todas las notificaciones
# y los pagos aprobados quedan en "pendiente". El polling del cliente
# reconcilia contra la API de MP como red de seguridad, pero el secret tiene que
# ser el real. Mínimo 32 caracteres.
MP_WEBHOOK_SECRET=
# Base pública de la web (canonical/og:sitemap). Dejalo vacío para que se
# derive sola del dominio (funciona en *.onrender.com y dominios propios).
PUBLIC_BASE_URL=http://localhost:3001
DEMO_MODE=true

# Panel admin
ADMIN_USER=admin
ADMIN_PASSWORD=fusionwok
ADMIN_TOKEN_TTL_MS=86400000

# CORS (vacío = solo mismo origen)
ALLOWED_ORIGINS=

# Turso (base de datos remota, obligatoria: el server no arranca sin esto)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Envío (Tandil): $4000 fijos hasta 20 cuadras a la redonda del local, y
# $100 por cada cuadra extra (una cuadra ≈ 130 m → ~2,6 km de franquicia).
# Cálculo 100% gratis: geocoding con Nominatim/Photon (OSM) y rutas gratis.
#
# Todas las de abajo son OPCIONALES: si no están seteadas, el server usa los
# defaults de server/shipping.js (4000 / 100 / 20 / 130 / sin tope). En Render
# hay que cargarlas a mano en el dashboard (en render.yaml van con sync: false).

# Clave GRATUITA de OpenRouteService (una cuenta en openrouteservice.org):
# rutas por calles más precisas para Argentina. Sin ella cae a OSRM y después
# a distancia en línea recta, así que el envío igual se calcula.
ORS_API_KEY=
# Costo fijo de las primeras SHIPPING_FLAT_BLOCKS cuadras (la base del envío).
SHIPPING_BASE_COST=4000
# Costo de cada cuadra que se pasa de la franquicia.
SHIPPING_PER_BLOCK=100
# Cuántas cuadras a la redonda entran en el costo fijo (la "franquicia").
SHIPPING_FLAT_BLOCKS=20
# Metros que mide una cuadra (Tandil ≈ 130 m). Los geocoders devuelven metros y
# esta variable los convierte a cuadras.
SHIPPING_BLOCK_METERS=130
# Tope de reparto en cuadras: más allá se rechaza como "fuera de zona".
# Vacío o 0 = SIN tope (reparto sin límite de cobertura, que es la regla
# comercial de hoy). Acá 300 cuadras ≈ 39 km, o sea en la práctica sin tope.
SHIPPING_MAX_BLOCKS=300