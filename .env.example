PORT=3001

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Base pública de la web (canonical/og:sitemap). Dejalo vacío para que se
# derive sola del dominio (funciona en *.onrender.com y dominios propios).
PUBLIC_BASE_URL=http://localhost:3001
DEMO_MODE=true

# Panel admin
ADMIN_USER=admin
ADMIN_PASSWORD=fusionwok
ADMIN_TOKEN_TTL_MS=86400000

# CORS (vacío = solo mismo origen)
ALLOWED_ORIGINS=

# Turso (base de datos remota, obligatoria: el server no arranca sin esto)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Envío (Tandil): $4000 base + $100 por cuadra (1 cuadra ≈ 100 m).
# 0 cuadras = solo base (la dirección del propio local).
# Cálculo 100% gratis: geocoding con Nominatim/Photon (OSM) y rutas gratis.
# Opcional (recomendado): clave GRATUITA de OpenRouteService (una cuenta en
# openrouteservice.org) → rutas por calles más precisas para Argentina.
ORS_API_KEY=
SHIPPING_BASE_COST=4000
SHIPPING_PER_BLOCK=100
SHIPPING_MAX_KM=40